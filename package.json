{
  "name": "@shhh-studio/folio",
  "version": "0.1.1",
  "description": "A small local website builder. Inline Markdown, reusable sections, portable content and static output.",
  "type": "module",
  "license": "MIT",
  "author": "Shhh Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/shhhstudio/folio.git"
  },
  "homepage": "https://github.com/shhhstudio/folio#readme",
  "bugs": {
    "url": "https://github.com/shhhstudio/folio/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "folio": "bin/folio.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./src/design-system/styles.css",
    "./themes/neutral.css": "./themes/neutral.css"
  },
  "files": [
    "bin",
    "lib",
    "dist",
    "src/design-system",
    "src/editor",
    "themes",
    "assets",
    "template",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/package.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && node bin/folio.mjs dev --root examples/blank",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "4.6.7",
    "vite": "8.3.8",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.27.0",
    "storybook": "10.6.7",
    "typescript": "5.9.3"
  }
}
